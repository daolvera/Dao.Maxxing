<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>Dao.Maxxing.Api-authentication</UserSecretsId>
    <!--
      Every build writes the OpenAPI document to /openapi. It is committed: the Angular client is
      generated from it, and CI fails when either one is out of date with the code.
    -->
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name dao-maxxing-api</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.6.4" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dao.Maxxing.Core\Dao.Maxxing.Core.csproj" />
    <ProjectReference Include="..\Dao.Maxxing.Services\Dao.Maxxing.Services.csproj" />
    <ProjectReference Include="..\Dao.Maxxing.ServiceDefaults\Dao.Maxxing.ServiceDefaults.csproj" />
  </ItemGroup>

  <!--
    Regenerates the Angular client whenever the OpenAPI document changes. Skipped when the web
    project has no node_modules (the dotnet CI job, container publish); CI's web job checks the client.
  -->
  <PropertyGroup>
    <WebProjectDirectory>$(MSBuildThisFileDirectory)..\Dao.Maxxing.Web\</WebProjectDirectory>
  </PropertyGroup>
  <Target Name="GenerateAngularApiClient"
          AfterTargets="Build"
          Condition="Exists('$(WebProjectDirectory)node_modules\ng-openapi-gen')"
          Inputs="$(OpenApiDocumentsDirectory)\dao-maxxing-api.json;$(WebProjectDirectory)ng-openapi-gen.json"
          Outputs="$(IntermediateOutputPath)angular-api-client.stamp">
    <Exec Command="npm run generate:api --silent" WorkingDirectory="$(WebProjectDirectory)" />
    <Touch Files="$(IntermediateOutputPath)angular-api-client.stamp" AlwaysCreate="true" />
  </Target>

</Project>
